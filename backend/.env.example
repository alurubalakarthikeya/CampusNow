# CampusNow backend configuration — placeholders only.
# Copy to backend/.env and fill in for your environment. Never commit .env.

APP_ENV=development

# SQLite is fine for local development and for running the test suite.
# A deployed environment needs a real database and its own backup plan.
DATABASE_URL=sqlite:///./campusnow.db

# Where the campus directory (blocks and teams) is read from. Leave unset to
# serve an honest empty collection instead of invented campus data.
CAMPUS_DIRECTORY_PATH=

# --- Authentication -------------------------------------------------------
# The campus identity provider that issues student tokens. Until these are
# set, authenticated endpoints answer 503 and identify themselves as
# unconfigured: there is no bypass and no fake login.
AUTH_ISSUER=
AUTH_AUDIENCE=
AUTH_JWKS_URL=

# Development-only convenience: accepts one fixed token for local work. The
# application refuses to start with this enabled when APP_ENV=production.
AUTH_DEV_MODE=false
AUTH_DEV_TOKEN=

# --- ServiceNow (future phase) -------------------------------------------
# Credentials live here and nowhere else. They are never sent to the mobile
# app, and leaving them empty simply keeps the adapter unconfigured.
SERVICENOW_INSTANCE_URL=
SERVICENOW_CLIENT_ID=
SERVICENOW_CLIENT_SECRET=
SERVICENOW_ASSIGNMENT_GROUP=
