{
  "expo": {
    "name": "CampusNow",
    "slug": "campusnow",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "scheme": "campusnow",
    "userInterfaceStyle": "automatic",
    "web": {
      "output": "single"
    },
    "backgroundColor": "#FFFFFF",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "CampusNow uses the camera to scan campus QR codes and attach photos to reports.",
        "NSLocationWhenInUseUsageDescription": "CampusNow uses your location to suggest the nearest campus building for a report.",
        "NSPhotoLibraryUsageDescription": "CampusNow attaches photos from your library as evidence on a report."
      }
    },
    "android": {
      "package": "com.carty.campusnow",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },

    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/logo.png",
          "imageWidth": 160,
          "dark": {
            "backgroundColor": "#08090A",
            "image": "./assets/images/logo.png"
          }
        }
      ],
      "expo-notifications",
      [
        "expo-camera",
        {
          "cameraPermission": "CampusNow uses the camera to scan campus QR codes and attach photos to reports."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "CampusNow uses your location to suggest the nearest campus building for a report."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "CampusNow attaches photos from your library as evidence on a report."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "220f881c-6037-4501-b4db-4d52ba0b74e0"
      }
    }
  }
}
